    {
      "name": "TC-API-03 Get all brands",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status code is 200\", function(){\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test(\"Response code is 200\",function(){\n    pm.expect(body.responseCode).to.equal(200);\n});\n\npm.test(\"Every brand has id and brand\",function(){\n    body.brands.forEach(function(item){\n        pm.expect(item).to.include.all.keys(\"id\",\"brand\");\n    });\n});\n\npm.test(\"Every brand is listed only once\", function(){\n    const names = body.brands.map(function(item){\n        return item.brand;\n    });\n    const uniqueNames = new Set(names);\n    pm.expect(uniqueNames.size).to.equal(names.length);\n});"
            ]
          }
        }
