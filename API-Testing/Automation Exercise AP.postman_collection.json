    {
      "name": "TC-API-05 POST to search product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status code is 200\", function(){\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test(\"Response code is 200\",function(){\n    pm.expect(body.responseCode).to.equal(200);\n});\n\npm.test(\"Every product matches the search term 'top'\", function(){\n    body.products.forEach(function(product){\n        const name = product.name.toLowerCase();\n        const category = product.category.category.toLowerCase();\n        pm.expect(name.includes(\"top\") || category.includes(\"top\"), \"Product does not match 'top': \"+ product.name).to.be.true;\n    });\n});"
            ]
          }
        }
      ],
