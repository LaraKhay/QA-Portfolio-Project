    {
      "name": "TC-API-01 Get all products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Check HTTP status code\npm.test(\"Status code is 200\", function(){\n    pm.response.to.have.status(200);\n});\n\n// 2. Read the JSON body once, so we can check it\nconst body = pm.response.json();\n\n// 3. Check response code inside the body\npm.test(\"response code is 200\",function(){\n    pm.expect(body.responseCode).to.equal(200);\n});\n\n// 4. Check that every product has required fields\npm.test(\"Every product has id, name, price, brand and category.\",function(){\n   body.products.forEach(function(product){\n        pm.expect(product).to.include.all.keys(\"id\",\"name\",\"price\",\"brand\",\"category\");\n   });\n});\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://automationexercise.com/api/productsList",
          "protocol": "https",
          "host": [
            "automationexercise",
            "com"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      },
      "response": []
